{
  "name": "ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "postinstall": "npm run generate:api-client && npm run generate:schema-types",
    "prestart": "node scripts/generate-environments.js",
    "start": "ng serve",
    "prebuild": "node scripts/generate-environments.js",
    "build": "ng build",
    "build-demo": "npm run build -- --configuration docs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:api-client": "node scripts/setup-api-client.js",
    "generate:schema-types": "node scripts/generate-schema-types.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.8.0",
  "dependencies": {
    "@angular/animations": "^21.1.4",
    "@angular/cdk": "^21.1.4",
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/material": "^21.1.4",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@ngxs/router-plugin": "^21.0.0",
    "@ngxs/storage-plugin": "^21.0.0",
    "@ngxs/store": "^21.0.0",
    "@openfeature/flagd-web-provider": "^0.7.4",
    "@openfeature/ofrep-web-provider": "^0.3.5",
    "@openfeature/web-sdk": "^1.7.2",
    "ajv": "^8.12.0",
    "json-logic-engine": "^5.0.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.2.3",
    "@analogjs/vitest-angular": "^2.2.3",
    "@angular/build": "^21.1.4",
    "@angular/cli": "^21.1.4",
    "@angular/compiler-cli": "^21.1.0",
    "@playwright/test": "^1.58.2",
    "@vitest/browser-playwright": "^4.0.18",
    "angular-eslint": "21.2.0",
    "eslint": "^9.39.2",
    "jsdom": "^27.1.0",
    "json-schema-to-typescript": "^15.0.4",
    "playwright": "^1.58.2",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.50.1",
    "vitest": "^4.0.8"
  }
}
